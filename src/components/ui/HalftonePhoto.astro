---
// Tratamento "recorte fotográfico" do manual: P&B alto contraste + retícula
// halftone sobreposta (estilo xerox/fanzine). Recebe qualquer src já
// resolvida (ex.: saída de getImage() ou caminho em public/).
export interface Props {
  src: string;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;
---

<div class:list={['relative overflow-hidden', className]}>
  <img
    src={src}
    alt={alt}
    class="h-full w-full object-cover [filter:grayscale(1)_contrast(1.3)]"
    loading="lazy"
  />
  <div
    class="pointer-events-none absolute inset-0 mix-blend-multiply"
    style="background-image: radial-gradient(color-mix(in srgb, var(--color-brand) 55%, transparent) 1px, transparent 1.2px); background-size: 4px 4px; opacity: 0.35;"
    aria-hidden="true"
  >
  </div>
</div>
