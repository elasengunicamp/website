---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Início">
  <section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-ink-heading dark:text-ink-dark-heading sm:text-5xl">
      Elas na <span class="font-script text-brand dark:text-brand-lilac">Engenharia</span>
    </h1>
    <p class="mt-4 font-body text-lg text-ink dark:text-ink-dark">
      Site em construção — Fase 0: fundação de identidade visual (cores, tipografia, dark mode).
    </p>
    <div class="mx-auto mt-10 grid max-w-md grid-cols-3 gap-3">
      <div class="h-16 rounded-sticker bg-brand-cream shadow-sticker"></div>
      <div class="h-16 rounded-sticker bg-brand shadow-sticker"></div>
      <div class="h-16 rounded-sticker bg-brand-lilac shadow-sticker"></div>
    </div>
  </section>
</BaseLayout>
