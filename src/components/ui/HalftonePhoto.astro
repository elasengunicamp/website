---
// Tratamento "recorte fotográfico" do manual: P&B alto contraste + retícula
// halftone sobreposta (estilo xerox/fanzine). Recebe qualquer src já
// resolvida (ex.: saída de getImage() ou caminho em public/).
export interface Props {
  src: string;
  alt: string;
  class?: string;
  // enquadramento da imagem dentro da caixa (default: cobre, cortando o excedente)
  fit?: 'cover' | 'contain';
  // ponto de foco ao cortar (ex.: 'center', 'top', '50% 30%')
  position?: string;
  // false = mantém a foto colorida, só a retícula (ex.: capas de livro na biblioteca)
  grayscale?: boolean;
}

const {
  src,
  alt,
  class: className,
  fit = 'cover',
  position = 'center',
  grayscale = true,
} = Astro.props;
---

<div class:list={['relative overflow-hidden', className]}>
  <img
    src={src}
    alt={alt}
    class:list={[
      'h-full w-full',
      grayscale ? '[filter:grayscale(1)_contrast(1.3)]' : 'contrast-105',
      fit === 'contain' ? 'object-contain' : 'object-cover',
    ]}
    style={`object-position: ${position};`}
    loading="lazy"
  />
  <div
    class="pointer-events-none absolute inset-0 mix-blend-multiply"
    style="background-image: radial-gradient(color-mix(in srgb, var(--color-brand) 55%, transparent) 1px, transparent 1.2px); background-size: 4px 4px; opacity: 0.35;"
    aria-hidden="true"
  >
  </div>
</div>
