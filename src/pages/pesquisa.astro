---
// "Pesquisa/Elas indica" (NOTES.md) — formato blog, mas conteúdo separado do
// blog de marketing: cards lidos como referência acadêmica/citação (autores,
// veículo, DOI, data), não como post genérico. Cada card é "fixado" com um
// pin lilás (public/graphics/icons/17.png — revisado, ver graphics-manifest.ts).
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import StickerFrame from '../components/ui/StickerFrame.astro';
import type { Tilt } from '../components/ui/StickerFrame.astro';
import { formatarData } from '../lib/date';

const indicacoes = (await getCollection('pesquisa')).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf(),
);

const tilts: Tilt[] = [-2, 1, -1, 2];

function formatarAutores(autores: string[]) {
  if (autores.length <= 1) return autores[0] ?? '';
  return `${autores.slice(0, -1).join(', ')} e ${autores[autores.length - 1]}`;
}
---

<BaseLayout
  title="Pesquisa"
  description="Elas indica — artigos, estudos e eventos acadêmicos sobre equidade de gênero nas engenharias, indicados pelo Elas na Engenharia."
>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading eyebrow="Pesquisa">Elas indica</SectionHeading>
    <p class="mt-4 max-w-2xl font-body text-base text-ink dark:text-ink-dark">
      Artigos, estudos e eventos indicados pelo time — referências acadêmicas sobre participação
      feminina e equidade de gênero nas engenharias.
    </p>

    {indicacoes.length === 0 && (
      <p class="mt-12 font-body text-sm text-ink dark:text-ink-dark">
        Nenhuma indicação publicada ainda.
      </p>
    )}

    <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2">
      {indicacoes.map((entry, i) => {
        const { titulo, autores, revistaOuEvento, doi, data, resumo } = entry.data;
        return (
          <div class="relative pt-4">
            <img
              src="/graphics/icons/17.png"
              alt=""
              aria-hidden="true"
              class:list={[
                'pointer-events-none absolute -top-3 z-10 w-11 drop-shadow-md',
                i % 2 === 0 ? 'left-7 -rotate-[8deg]' : 'right-9 rotate-[10deg]',
              ]}
            />
            <StickerFrame tilt={tilts[i % tilts.length]} class="block w-full">
              <a href={`/pesquisa/${entry.id}`} class="block p-6 sm:p-7">
                <p class="font-mono text-xs tracking-wide text-accent-purple">{formatarData(data)}</p>
                <h3 class="mt-2 font-heading text-lg font-bold leading-snug text-ink-heading dark:text-ink-dark-heading">
                  {titulo}
                </h3>
                <p class="mt-3 font-body text-sm text-ink dark:text-ink-dark">
                  <span class="font-semibold text-ink-heading dark:text-ink-dark-heading">
                    {autores.length > 1 ? 'Autoras/es: ' : 'Autoria: '}
                  </span>
                  {formatarAutores(autores)}
                </p>
                {revistaOuEvento && (
                  <p class="mt-1 font-body text-sm italic text-accent-purple">{revistaOuEvento}</p>
                )}
                <p class="mt-3 line-clamp-3 font-body text-sm leading-relaxed text-ink dark:text-ink-dark">
                  {resumo}
                </p>
                <div class="mt-5 flex items-center justify-between gap-3 border-t border-dashed border-brand/20 pt-4 dark:border-brand-lilac/20">
                  {doi ? (
                    <span class="inline-flex items-center rounded-full bg-accent-purple/15 px-2.5 py-1 font-mono text-[11px] text-accent-purple">
                      DOI: {doi}
                    </span>
                  ) : (
                    <span class="font-body text-xs text-ink/60 dark:text-ink-dark/60">DOI indisponível</span>
                  )}
                  <span class="font-body text-sm font-semibold text-brand dark:text-brand-lilac">
                    Ler indicação →
                  </span>
                </div>
              </a>
            </StickerFrame>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>
