---
// Menu mobile sem JS: <details>/<summary> nativo controla abrir/fechar.
export interface NavLink {
  href: string;
  label: string;
}

export interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<details class="group relative md:hidden">
  <summary
    class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full text-ink hover:bg-brand-lilac dark:text-ink-dark dark:hover:bg-brand-dark-surface [&::-webkit-details-marker]:hidden"
    aria-label="Abrir menu"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path class="group-open:hidden" d="M3 5h14M3 10h14M3 15h14" />
      <path class="hidden group-open:block" d="M4 4l12 12M16 4L4 16" />
    </svg>
  </summary>

  <nav class="absolute right-0 top-12 flex w-48 flex-col gap-1 rounded-xl border border-brand/10 bg-brand-cream p-3 shadow-lg dark:border-brand-lilac/10 dark:bg-brand-dark">
    {links.map((link) => (
      <a
        href={link.href}
        class="rounded-lg px-3 py-2 font-body text-sm font-medium text-ink hover:bg-brand-lilac dark:text-ink-dark dark:hover:bg-brand-dark-surface"
      >
        {link.label}
      </a>
    ))}
  </nav>
</details>
