---
// Detalhe de post do blog — capa halftone + fita washi, metadados (autor,
// data, tags) e corpo em MDX (ver content.config.ts e astro.config.mjs).
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import HalftonePhoto from '../../components/ui/HalftonePhoto.astro';
import { formatarData } from '../../lib/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { titulo, autor, cover, resumo, tags, data } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={titulo} description={resumo}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 font-body text-sm font-semibold text-brand hover:text-accent-purple dark:text-brand-lilac"
    >
      ← Blog
    </a>

    {tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-1.5">
        {tags.map((tag) => <Badge accent="blue">{tag}</Badge>)}
      </div>
    )}

    <h1 class="mt-3 font-heading text-3xl font-bold leading-tight text-ink-heading dark:text-ink-dark-heading">
      {titulo}
    </h1>

    <div class="mt-3 flex items-center gap-2 font-body text-sm text-ink/70 dark:text-ink-dark/70">
      <span class="font-semibold text-ink dark:text-ink-dark">{autor}</span>
      <span aria-hidden="true">·</span>
      <span>{formatarData(data, 'longa')}</span>
    </div>

    <div class="relative mt-8 overflow-hidden rounded-sticker shadow-sticker">
      <HalftonePhoto src={cover} alt={titulo} class="h-72 w-full sm:h-96" />
      <img
        src="/graphics/textures/52.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute -top-4 left-12 w-28 -rotate-6 opacity-95"
      />
    </div>

    <div class="post-body mt-10 font-body text-base leading-relaxed text-ink dark:text-ink-dark">
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-1.5 border-t border-dashed border-brand/20 pt-6 dark:border-brand-lilac/20">
        {tags.map((tag) => <Badge accent="purple">{tag}</Badge>)}
      </div>
    )}
  </article>
</BaseLayout>

<style is:global>
  /* Tipografia do corpo MDX do post — sem plugin @tailwindcss/typography,
     estilos escritos à mão pra combinar com os tokens da marca. */
  .post-body > * + * {
    margin-top: 1.1em;
  }
  .post-body h2,
  .post-body h3 {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-ink-heading);
    margin-top: 1.6em;
  }
  :where(.dark) .post-body h2,
  :where(.dark) .post-body h3 {
    color: var(--color-ink-dark-heading);
  }
  .post-body h2 {
    font-size: 1.4rem;
  }
  .post-body h3 {
    font-size: 1.15rem;
  }
  .post-body a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  :where(.dark) .post-body a {
    color: var(--color-brand-lilac);
  }
  .post-body ul,
  .post-body ol {
    padding-left: 1.4em;
  }
  .post-body ul {
    list-style: disc;
  }
  .post-body ol {
    list-style: decimal;
  }
  .post-body blockquote {
    border-left: 3px solid var(--color-accent-purple);
    padding-left: 1em;
    font-style: italic;
    color: var(--color-ink);
  }
  :where(.dark) .post-body blockquote {
    color: var(--color-ink-dark);
  }
  .post-body img {
    border-radius: var(--radius-sticker);
    box-shadow: var(--shadow-sticker);
  }
  .post-body code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: color-mix(in srgb, var(--color-accent-purple) 12%, transparent);
    padding: 0.15em 0.35em;
    border-radius: 0.35em;
  }
</style>
