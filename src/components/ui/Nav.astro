---
import ThemeToggle from './ThemeToggle.astro';
import MobileMenu from './MobileMenu.astro';

// IA conforme NOTES.md — confirmar rótulos/ordem finais com o time (ver PROJECT-NOTES.md).
const links = [
  { href: '/', label: 'Início' },
  { href: '/blog', label: 'Blog' },
  { href: '/acoes', label: 'Ações' },
  { href: '/parcerias', label: 'Parcerias' },
  { href: '/pesquisa', label: 'Pesquisa' },
  { href: '/escolas', label: 'Escolas' },
  { href: '/contato', label: 'Contato' },
];
---

<header class="sticky top-0 z-40 border-b border-brand/10 bg-brand-cream/90 backdrop-blur dark:border-brand-lilac/10 dark:bg-brand-dark/90">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2">
      <img
        src="/images/brand/logo-icon-solid.webp"
        alt="Elas na Engenharia"
        width="256"
        height="256"
        class="h-10 w-10 dark:hidden"
      />
      <img
        src="/images/brand/logo-icon-solid-light.webp"
        alt=""
        aria-hidden="true"
        width="256"
        height="256"
        class="hidden h-10 w-10 dark:block"
      />
      <img
        src="/images/brand/lockup-horizontal.webp"
        alt="Elas na Engenharia"
        width="147"
        height="20"
        class="hidden h-5 w-auto sm:block sm:dark:hidden"
      />
      <img
        src="/images/brand/lockup-horizontal-light.webp"
        alt=""
        aria-hidden="true"
        width="147"
        height="20"
        class="hidden h-5 w-auto sm:dark:block"
      />
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="font-body text-sm font-medium text-ink transition-colors hover:text-brand dark:text-ink-dark dark:hover:text-brand-lilac"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <MobileMenu links={links} />
    </div>
  </div>
</header>
