---
import { getEntry } from 'astro:content';

const currentYear = new Date().getFullYear();

// Rodapé editável no CMS (singleton "config"). Fallback hardcoded pra build
// nunca quebrar se o singleton faltar ou for inválido.
const site = (await getEntry('site', 'config'))?.data;

const socials = (
  site?.redes ?? [
    { label: 'Instagram', href: 'https://instagram.com/elasnaengenharia.unicamp', tipo: 'instagram', visivel: true },
    { label: 'YouTube', href: 'https://youtube.com/@elasnaengenharia', tipo: 'youtube', visivel: false },
    { label: 'TikTok', href: 'https://tiktok.com/@elasnaengenharia', tipo: 'tiktok', visivel: false },
    { label: 'E-mail', href: 'mailto:contato@elasnaengenharia.com.br', tipo: 'email', visivel: true },
  ]
).filter((s) => s.visivel !== false);
const copyright =
  site?.copyrightTexto ?? 'Elas na Engenharia — FEM/Unicamp. Projeto de extensão.';
---

<footer class="bg-brand text-brand-cream dark:bg-brand-dark-surface">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div class="flex flex-col gap-3">
      <a href="/" class="inline-flex">
        <img
          src="/images/brand/lockup-horizontal-light.webp"
          alt="Elas na Engenharia"
          width="177"
          height="24"
          class="h-6 w-auto"
        />
      </a>
      <p class="font-body text-sm">
        &copy; {currentYear} {copyright}
      </p>
    </div>

    <nav class="flex items-center gap-5">
      {socials.map((social) => (
        <a
          href={social.href}
          class="font-body text-sm text-brand-cream/80 transition-colors hover:text-brand-lilac"
          target={social.href.startsWith('http') ? '_blank' : undefined}
          rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          {social.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
